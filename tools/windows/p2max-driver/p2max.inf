; p2max.inf
; Binds the inbox WinUSB driver to Thermal Master P2 Max (VID_3474&PID_42B2)
; so that the Thermal Master Web Viewer can open it from the browser via WebUSB.
;
; Reuses the Windows inbox winusb.inf, so there are no external .dll/.sys files.
; It DOES need a catalog: Windows refuses a driver package that has none, and
; the catalog name must be declared here: pnputil and dpscat both read this
; field to know which file the package owns. install.ps1 generates p2max.cat
; with dpscat.exe, signs it locally, and only then installs.

[Version]
Signature   = "$Windows NT$"
Class       = USBDevice
ClassGuid   = {88BAE032-5A81-49F0-BC3D-A4FF138216D6}
CatalogFile = p2max.cat
Provider    = "Thermal Master"
DriverVer   = 10/31/2026,1.0.0.0

[Manufacturer]
%Manufacturer% = Models, NTamd64, NTx86, NTarm64

[Models.NTamd64]
; Match both the interface (MI_00) and the bare device, in case the
; interface number differs between firmware revisions.
%DeviceName% = WinUSBInstall, USB\VID_3474&PID_42B2&MI_00
%DeviceName% = WinUSBInstall, USB\VID_3474&PID_42B2

[Models.NTx86]
%DeviceName% = WinUSBInstall, USB\VID_3474&PID_42B2&MI_00
%DeviceName% = WinUSBInstall, USB\VID_3474&PID_42B2

[Models.NTarm64]
%DeviceName% = WinUSBInstall, USB\VID_3474&PID_42B2&MI_00
%DeviceName% = WinUSBInstall, USB\VID_3474&PID_42B2

[WinUSBInstall]
Include = winusb.inf
Needs   = WINUSB.NT

[WinUSBInstall.HW]
Include = winusb.inf
Needs   = WINUSB.NT.HW

[WinUSBInstall.Services]
Include = winusb.inf
Needs   = WINUSB.NT.Services

[Strings]
Manufacturer = "Thermal Master"
DeviceName   = "Thermal Master P2 Max (WinUSB)"
